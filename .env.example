# Solana RPC used by the API and indexer.
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
SOLANA_TX_LIMIT=25

# API / dashboard.
PORT=3001
NEXT_PUBLIC_API_URL=http://localhost:3001

# Kafka realtime pipeline. Use localhost:9092 with infrastructure/docker/docker-compose.yml.
KAFKA_BROKERS=localhost:9092

# Neo4j graph storage. The local compose file uses this password.
NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=anti-sybil-local

# Optional address for standalone indexer smoke tests.
WALLET_ADDRESS=11111111111111111111111111111111
